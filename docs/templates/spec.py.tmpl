"""$NAME の設計値。**寸法・部品・行列の決定はここに集める。**

プレート・基板・ファームウェア・ケースはすべてここを読む。同じ値を 2 か所に
書かない（HHKB でネジ位置をプレートとケースで別々に持ち、食い違わせた）。

値ごとに**なぜその値か**をコメントで残す。推定で置いた値には `[暫定]` を
代入の行に付け、docs/provisional-values.md に同じ数値で載せる（検査が突き合わせる）。
読まれなくなった値は消すか `[記録のみ]` と書く（検査が見る）。
"""

NAME = "$NAME"               # 基板のシルクに刷る名前。**他社の商標を刷らない**
LAYOUT = "layout.json"       # KLE。回転・ISO キーは未対応（読むと止まる）
PIECES = $PIECES             # 配列の島を左から。一体型なら ("main",)

# キー領域からプレート外形までの余白（片側）。実機を再現するなら実機の外形から出す
PLATE_MARGIN_X = 4.125       # [暫定] 左右
PLATE_MARGIN_Y = 6.375       # [暫定] 前後
CORNER_R = 3.0
# プレート外形から基板外形まで（片側）。ケースの壁の内側に収める
PCB_INSET_X = 3.0
PCB_INSET_Y = 5.3

# 取付ネジ（プレートと基板で共有・CAD 座標＝キー領域の中心が原点・Y 上向き・mm）。
# 置き場所の 5 条件（縁から 1.0 以上・キーとプレート開口・部品・コートヤード・配線）を
# **同時に**満たすこと（HHKB で別々に確かめて 3 往復した）
MOUNTS = {p: [] for p in PIECES}

# 行列。"physical"（物理の x で列を決める）か "ordinal"（段の中で左から何番目か）。
# 個別に直すなら MATRIX_OVERRIDE = {部品: {キーマップ上の番号: (row, col)}}
MATRIX_COLUMNS = "physical"

# ZMK。pins を書くまでシールドは #error で止まる（空の kscan で黙ってビルドさせない）
ZMK = {
    "shield": "$SHIELD",
    "board": "xiao_ble//zmk",
    # "pins": {"left": {"rows": ["&xiao_d 1", ...], "cols": ["&shifter 0", ...]}},
}
