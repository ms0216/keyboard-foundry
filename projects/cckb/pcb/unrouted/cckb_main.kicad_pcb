	(footprint "XIAO_nRF52840_SMD"
		(layer "F.Cu")
		(uuid "f105112f-4664-4456-95d4-7d72c3fe491e")
		(at 17.394 138.1 90)
		(descr "Seeed XIAO nRF52840 を基板に平らに表面実装（キャステレーション）。ピンの並び・向きは XIAO_nRF52840（スルーホール版・公式ライブラリと照合済み）と同じ。パッドは XIAO の裏のパッド（公式 STEP: 幅 1.524・半円まで含めて縁から内へ 2.032）を覆い、縁から内へ 2.2（Seeed 公式 XIAO-nRF52840-SMD のランド 2.18 に揃える・spec.XIAO_PAD_IN。前の 2.85 は裏の露出パッド NFC2 に届いた）・外へ 0.6（こて先用・spec.XIAO_PAD_EXT）。D0〜D6 の列は外へ出る場所が基板の縁で無いので、パッドの外寄りにビア φ0.7/0.3（アニュラ 0.2。JLC の部品の穴の下限 0.18 を満たす）を持つ（同じ番号のスルーホールパッド）。出典と測り方は lib/README.md")
		(tags "seeed xiao nrf52840 smd castellated")
		(property "Reference" "U_MCU"
			(at 0 -12.2 90)
			(layer "F.SilkS")
			(uuid "50369444-5b76-4ba3-8b82-315f9dfcf042")
