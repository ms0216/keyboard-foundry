/*
 * **生成物。手で直さない。** python -m foundry.zmk cckb
 * 配列（layout.json）と spec.py の行列設定から作る。基板と同じ割り当て。
 * 並び順はキーマップと同じ（部品を左から、部品の中は上の段から左→右）。
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
	chosen {
		zmk,matrix-transform = &default_transform;
	};

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <15>;
		rows = <5>;
		map = <
			/* main（col-offset 0） */
			RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7)
			RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(1,0)
			RC(1,1) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
			RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(2,0) RC(2,2) RC(2,3)
			RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
			RC(2,12) RC(2,13) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)
			RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,13) RC(3,14) RC(4,1)
			RC(4,3) RC(4,5) RC(4,6) RC(4,8) RC(4,10) RC(4,12)
		>;
	};
};
