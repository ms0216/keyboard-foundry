/* cckb。雛形から作った。以後は人が持つ。
 * 並びは cckb-transform.dtsi の map と同じ。&none は刻印から推せなかったキー。
 * **&bootloader と &bt BT_CLR を必ずどこかに置く**（ケースを開けずに復旧できるように）。
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
	keymap {
		compatible = "zmk,keymap";

		base {
			bindings = <
				&kp ESC       // Esc
				&kp N1        // 1
				&kp N2        // 2
				&kp N3        // 3
				&kp N4        // 4
				&kp N5        // 5
				&kp N6        // 6
				&kp N7        // 7
				&kp N8        // 8
				&kp N9        // 9
				&kp N0        // 0
				&kp MINUS     // -
				&kp EQUAL     // =
				&kp BSLH      // \
				&kp GRAVE     // `
				&kp TAB       // Tab
				&kp Q         // Q
				&kp W         // W
				&kp E         // E
				&kp R         // R
				&kp T         // T
				&kp Y         // Y
				&kp U         // U
				&kp I         // I
				&kp O         // O
				&kp P         // P
				&kp LBKT      // [
				&kp RBKT      // ]
				&kp DEL       // Del
				&kp LCTRL     // Ctrl
				&kp A         // A
				&kp S         // S
				&kp D         // D
				&kp F         // F
				&kp G         // G
				&kp H         // H
				&kp J         // J
				&kp K         // K
				&kp L         // L
				&kp SEMI      // ;
				&kp SQT       // '
				&kp RET       // Enter
				&kp LSHFT     // Shift
				&kp Z         // Z
				&kp X         // X
				&kp C         // C
				&kp V         // V
				&kp B         // B
				&kp N         // N
				&kp M         // M
				&kp COMMA     // ,
				&kp DOT       // .
				&kp FSLH      // /
				&kp LSHFT     // Shift
				&mo 1         // Fn
				&kp LALT      // Alt
				&kp LGUI      // Meta
				&kp SPACE     // Space
				&kp SPACE     // Space
				&kp SPACE     // Space
				&kp LGUI      // Meta
				&kp LALT      // Alt
			>;
		};

		fn {
			bindings = <
				&trans        // Esc
				&trans        // 1
				&trans        // 2
				&trans        // 3
				&trans        // 4
				&trans        // 5
				&trans        // 6
				&trans        // 7
				&trans        // 8
				&trans        // 9
				&trans        // 0
				&trans        // -
				&trans        // =
				&trans        // \
				&trans        // `
				&trans        // Tab
				&trans        // Q
				&trans        // W
				&trans        // E
				&trans        // R
				&trans        // T
				&trans        // Y
				&trans        // U
				&trans        // I
				&trans        // O
				&trans        // P
				&trans        // [
				&trans        // ]
				&trans        // Del
				&trans        // Ctrl
				&trans        // A
				&trans        // S
				&trans        // D
				&trans        // F
				&trans        // G
				&trans        // H
				&trans        // J
				&trans        // K
				&trans        // L
				&trans        // ;
				&trans        // '
				&trans        // Enter
				&trans        // Shift
				&trans        // Z
				&trans        // X
				&trans        // C
				&trans        // V
				&trans        // B
				&trans        // N
				&trans        // M
				&trans        // ,
				&trans        // .
				&trans        // /
				&trans        // Shift
				&trans        // Fn
				&trans        // Alt
				&trans        // Meta
				&trans        // Space
				&trans        // Space
				&trans        // Space
				&trans        // Meta
				&trans        // Alt
			>;
		};
	};
};
